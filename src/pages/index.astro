---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"

const newsletters = (await getCollection("newsletter")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
)
---

<Layout>
    <main class="font-serif flex justify-end mr-10 my-10 text-sm">
        <div class="w-[300px]">
            <h1>Ava Dinh-Vu</h1>
            <p>I like art and other people</p>
            <p>You can see my web design work <a>here</a></p>

            <hr />

            <button class="block"> my newsletter </button>
            <!-- {
                newsletters.map(({ data }) => {
                    return (
                        <div>
                            <button class="text-left">{data.subject}</button>
                        </div>
                    )
                })
            } -->

            <button class="block"> my games</button>

            <button class="block"> my archive</button>
        </div>
    </main>
</Layout>

