---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About – Ava Vu" description="hi, my name is ava and this is my website">
    <a href="/" class="link">
        <div class="w-full bg-blue-200 h-2"></div>
        <div class="w-full bg-pink-200 h-2"></div>
        <div class="w-full bg-white h-2"></div>
        <div class="w-full bg-pink-200 h-2"></div>
        <div class="w-full bg-blue-200 h-2"></div>

    </a>

    <main class="w-[40ch] mx-auto flex h-[90%] flex-col place-items-center justify-center">
        <div class="">
            <h1 class="font-bold">
                hi, my name is ava dinh-vu and this is my website
            </h1>
            <br>
            <p>
                i'm a web designer, writer, and game maker. i like art and other people.
            </p>
            <p>
                this website is an almost exhaustive list of everything i've made. from the <a class="link" href="https://www.youtube.com/watch?v=QPz52Ze-gyU">dramatic</a> to the <a class="link" href="https://www.youtube.com/watch?v=eL0-nSGcCBM">whimsical</a>.

                if you want to make something with me, send me an <a class="link" href="mailto:avadinhvu@gmailcom">email</a>.
            </p>
        </div>

        <div class="">
            <br>

            <p>
                i'm the creator of <a class="link" href="https://suburble.melbourne">suburble</a>, <a class="link" href="https://purple.avavu.au">the all purple challenge</a>, and 
                <a class="link" href="https://crossword.blue">crossword.blue</a>, i'm also a regular contributor to <a class="link" href="www.saturdayquiztime.com.au/editions/296/crossword/">saturday quiz time</a>.
            </p>

            <br>

            <p>
                source code for this website is available on my <a class="link" href="https://github.com/avavuvu/avavu.au">github</a>.
            </p>
        </div>
    </main>

</Layout>