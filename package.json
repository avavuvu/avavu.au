{
	"name": "avavu-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun scripts/wikiGraph/index.ts && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"postbuild": "npx svelte-sitemap",
		"add-image": "bun scripts/images/add-image.ts",
		"screenshot": "bun scripts/images/screenshot.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/bun": "^1.4.4",
		"@types/d3-force": "^3.0.10",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-transition": "^3.0.9",
		"@types/d3-zoom": "^3.0.9",
		"@types/mdast": "^4.0.4",
		"@types/unist": "^3.0.3",
		"commander": "^15.0.0",
		"graphology": "^0.26.0",
		"graphology-communities-louvain": "^2.0.2",
		"mdsvex": "^0.12.7",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@justinribeiro/lite-tiktok": "^0.1.0",
		"@justinribeiro/lite-youtube": "^1.9.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.6.0",
		"d3-force": "^3.0.0",
		"d3-selection": "^3.0.0",
		"d3-transition": "^3.0.1",
		"d3-zoom": "^3.0.0",
		"js-yaml": "^4.1.1",
		"lite-youtube-embed": "^0.3.4",
		"marked": "^18.0.5",
		"remark-wiki-link": "0.0.4",
		"rss-parser": "^3.13.0",
		"sharp": "^0.34.5",
		"slugify": "^1.6.9",
		"svelte-sitemap": "^3.1.0",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.6.5"
